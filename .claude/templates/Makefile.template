# Makefile — commands for using <APP NAME>
#
# Only tool targets live here: what a user of the app runs. Development
# commands (sync, tests, ruff) run through `uv` directly; see CLAUDE.md.

.PHONY: help

.DEFAULT_GOAL := help

help: ## List targets
	@awk 'BEGIN {FS = ":.*## "} \
		/^[a-zA-Z_-]+:.*## / {printf "  %-10s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# Add user-facing targets here as features land, each with a `## description`:
#   validate: ## Check a card
#   	uv run <app> check
